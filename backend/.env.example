DB_ENGINE=sqlite
# Para usar Dolphin/MySQL cambia a:
# DB_ENGINE=mysql
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DB=tienda_panaderia
# MYSQL_USER=root
# MYSQL_PASS=root

# v0.4 Postgres (docker-compose o Render/Fly):
# DB_ENGINE=postgres
# Opcion A: URL completa (la que te pasa Render)
# DATABASE_URL=postgresql://tienda:tienda123@localhost:5432/tienda_panaderia
# Opcion B: por partes
# PG_HOST=127.0.0.1
# PG_PORT=5432
# PG_DB=tienda_panaderia
# PG_USER=tienda
# PG_PASS=tienda123

# v0.4 Deploy: origen permitido del frontend (separados por coma) y puerto
# FRONTEND_ORIGIN=*
# PORT=5000
# SECRET_KEY=cambia-esto-en-produccion

# v0.4 Usuarios seed (solo si la tabla users esta vacia)
# SEED_DUENO_USER=dueno
# SEED_DUENO_PASS=dueno123
# SEED_VENDEDOR_USER=vendedora
# SEED_VENDEDOR_PASS=venta123
